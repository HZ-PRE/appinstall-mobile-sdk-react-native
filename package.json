{
  "name": "@appinstall/mobile-sdk-react-native",
  "version": "2.0.1",
  "description": "AppInstall React Native SDK for the current Go v2 attribution protocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node scripts/gen-version.mjs && tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs"
  },
  "keywords": [
    "appinstall",
    "react-native",
    "attribution",
    "deferred-deep-linking"
  ],
  "author": "AppInstall",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.4",
    "npm": ">=10.0.0"
  },
  "peerDependencies": {
    "@react-navigation/native": ">=6.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.76.0"
  },
  "peerDependenciesMeta": {
    "@react-navigation/native": {
      "optional": true
    }
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "react-native-device-info": "^15.0.0"
  },
  "devDependencies": {
    "@react-native-community/cli-config": "^20.0.0",
    "@types/react": "^19.1.0",
    "@vitest/coverage-v8": "^3.0.0",
    "prettier": "^3.6.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist",
    "src",
    "android/src",
    "android/build.gradle",
    "android/WALLE-LICENSE.txt",
    "android/WALLE-NOTICE.md",
    "ios",
    "AppInstallAttribution.podspec",
    "react-native.config.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "examples"
  ],
  "react-native": "src/index.ts",
  "sideEffects": false
}
